# Copiar a backend/.env (no versionado) y completar con credenciales reales.
# Sin RESEND_API_KEY, el backend cae a imprimir los correos en la consola de
# `runserver` — útil para desarrollar sin cuenta de Resend.

# API key de Resend (https://resend.com/api-keys). Se usa como password del
# SMTP relay smtp.resend.com, no como header HTTP.
RESEND_API_KEY=

# Remitente que verá el usuario. En la demo, con el dominio de prueba de
# Resend, debe ser exactamente onboarding@resend.dev (ver instrucciones en el
# chat/README). Con dominio propio verificado, puede ser cualquier dirección
# de ese dominio.
DEFAULT_FROM_EMAIL=EcoRecicla <onboarding@resend.dev>

# --- Solo producción (Render) — ver docs/plan-despliegue.md ---
# Sin estas, el backend sigue funcionando en modo desarrollo local como
# siempre (Postgres local, DEBUG=True, media en disco).

# SECRET_KEY=
# DEBUG=False
# ALLOWED_HOSTS=tu-servicio.onrender.com

# Connection string del Transaction pooler de Supabase (puerto 6543).
# DATABASE_URL=

# Credenciales S3 del bucket "media" de Supabase Storage (Storage → Settings
# → S3 Access Keys). Las 4 deben estar presentes para que se use Supabase
# Storage en vez del disco local.
# SUPABASE_S3_ENDPOINT=
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_S3_BUCKET=media
